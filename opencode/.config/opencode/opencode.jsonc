{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "lsp": "allow"
  },
  "formatter": true
}